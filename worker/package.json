{
  "name": "prism-short-worker",
  "version": "1.0.0",
  "private": true,
  "description": "JSON Prism short-link service — POST /s to store, GET /<slug> to redirect.",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy --env production",
    "tail": "wrangler tail --env production",
    "typecheck": "npm run types && tsc --noEmit",
    "deploy:production": "wrangler deploy --env production",
    "deploy:check": "wrangler deploy --env production --dry-run",
    "types": "wrangler types --strict-vars=false"
  },
  "devDependencies": {
    "typescript": "^5.8.3",
    "wrangler": "^4.131.2"
  }
}
