{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "json-prism-local",
  "main": "edge/index.ts",
  "account_id": "8294e44ced7d8f156440f89cc13b1bd4",
  "compatibility_date": "2026-09-15",
  "workers_dev": true,
  "assets": {
    "binding": "ASSETS",
    "run_worker_first": ["/*", "!/_next/*"],
    "directory": "./out",
    "html_handling": "force-trailing-slash",
    "not_found_handling": "404-page"
  },
  "observability": { "enabled": true },
  "env": {
    "production": {
      "name": "json-prism",
      "workers_dev": false,
      "routes": [
        {
          "pattern": "jsonprism.com",
          "custom_domain": true
        }
      ]
    }
  }
}
